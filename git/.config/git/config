# See https://git-scm.com/docs/git-config

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[init]
	defaultBranch = main
[pull]
	rebase = true 			 # Rebase (instead of merge) on pull
[push]
	autoSetupRemote = true   # Automatically set upstream branch on push
[diff]
	algorithm = histogram    # Clearer diffs on moved/edited lines
	colorMoved = plain       # Highlight moved blocks in diffs
	mnemonicPrefix = true    # More intuitive refs in diff output
[commit]
	verbose = true           # Include diff comment in commit message template
[column]
	ui = auto 			     # Output in columns when possible
[branch]
	sort = -committerdate    # Sort branches by most recent commit first
[tag]
	sort = -version:refname  # Sort version numbers as you would expect
[rerere]
	enabled = true           # Record and reuse conflict resolutions
	autoupdate = true        # Apply stored conflict resolutions automatically
[user]
	name = Sebastian Hirt
	# Work is the default: every company GitLab we touch is work, and private
	# work only ever lives on GitHub. Anything that is not github.com therefore
	# gets the work address, including hosts not yet seen and hosts whose name
	# says nothing about who runs them.
	email = sebastian.hirt@ancud.de

# github.com is the one personal remote, so it is the only exception. Each
# includeIf takes a single URL form; git has no way to OR them into one
# condition. The scp-style form needs both `:**` and `:*/**`, because `**` only
# crosses `/` when it is a whole path component, so `:**` alone would stop at
# the first slash and miss any owner/repo path.
# A repository with no remote at all keeps the work address above.
[includeIf "hasconfig:remote.*.url:git@github.com:**"]
	path = ~/.config/git/config-github
[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
	path = ~/.config/git/config-github
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/**"]
	path = ~/.config/git/config-github
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
	path = ~/.config/git/config-github
