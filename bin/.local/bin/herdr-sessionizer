#!/usr/bin/env bash

set -euo pipefail

projects_root="${1:-$HOME/projects}"
herdr_bin="${HERDR_BIN_PATH:-$HOME/.local/bin/herdr}"
fzf_bin="${FZF_BIN_PATH:-$HOME/.fzf/bin/fzf}"

selected="$({
  find "$projects_root" -mindepth 1 -maxdepth 2 -type d -exec test -d "{}/.git" \; -print
} | sort | "$fzf_bin" --prompt="Project> ")" || exit 0

[[ -n "$selected" ]] || exit 0

label="$(basename "$selected")"
workspace_id="$($herdr_bin api snapshot | jq -r --arg cwd "$selected" --arg label "$label" '
  .result.snapshot as $snapshot
  | ($snapshot.workspaces
    | map(select(. as $workspace | any($snapshot.panes[];
        .workspace_id == $workspace.workspace_id
        and (.cwd == $cwd or (.cwd | startswith($cwd + "/"))))))
    | first
    | .workspace_id)
    // ($snapshot.workspaces
      | map(select((.label | sub("^\\[[0-9]+\\][[:space:]]+"; "")) == $label))
      | first
      | .workspace_id)
    // empty
')"

if [[ -n "$workspace_id" ]]; then
  "$herdr_bin" workspace focus "$workspace_id" >/dev/null
else
  "$herdr_bin" workspace create --cwd "$selected" --label "$label" --focus >/dev/null
fi
