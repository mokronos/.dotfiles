#!/usr/bin/env python3

import argparse
import json
import os
import select
import subprocess
import sys


def zen_windows():
    clients = json.loads(subprocess.check_output(["hyprctl", "clients", "-j"]))
    return {client["pid"]: client["address"] for client in clients if client["class"] == "zen"}


def quit_browser(pid, address):
    try:
        descriptor = os.pidfd_open(pid)
    except ProcessLookupError:
        return
    try:
        window = json.dumps("address:" + address)
        for state in ("down", "up"):
            subprocess.run(
                [
                    "hyprctl",
                    "eval",
                    'hl.dispatch(hl.dsp.send_key_state({'
                    f'mods = "CTRL", key = "q", state = "{state}", window = {window}'
                    '}))',
                ],
                check=True,
                capture_output=True,
                text=True,
            )
        if not select.select([descriptor], [], [], 60)[0]:
            raise RuntimeError("Zen has not exited. Check its quit confirmation, then try again.")
    finally:
        os.close(descriptor)


def main():
    parser = argparse.ArgumentParser(description="Quit Zen before running an Omarchy power action.")
    parser.add_argument("action", choices=("reboot", "shutdown", "logout"))
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    windows = zen_windows()
    command = [f"/usr/share/omarchy/bin/omarchy-system-{args.action}"]
    if args.dry_run:
        print(f"Quit {len(windows)} Zen process(es) and wait for exit, then run {command[0]}")
        return
    for pid, address in windows.items():
        quit_browser(pid, address)
    os.execv(command[0], command)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        message = str(error)
        print(message, file=sys.stderr)
        subprocess.run(["notify-send", "Power action failed", message], check=False)
        sys.exit(1)
