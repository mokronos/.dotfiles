#!/bin/bash

# omarchy:summary=Turn the displays off (DPMS) instead of launching the TUI screensaver
#
# Shadows /usr/share/omarchy/bin/omarchy-launch-screensaver via PATH precedence,
# so the Omarchy shell's idle service powers the monitors down at the
# idle.screensaver timeout instead of rendering the terminal screensaver.
#
# Waking is handled by Hyprland's key_press_enables_dpms/mouse_move_enables_dpms
# plus the idle service's omarchy-system-wake call on activity.

# No isLocked guard here (unlike the stock launcher): blanking a locked screen
# is desirable power saving, and input still wakes the display.
omarchy-brightness-display off
