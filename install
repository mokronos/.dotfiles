#!/usr/bin/env bash

set -euo pipefail

DOTFILES="${HOME}/.dotfiles"
STOW_FOLDERS=(
  bin
  btop
  ckb-next
  cursor
  fastfetch
  ghostty
  home
  herdr
  hypr
  lazygit
  nvim
  opencode
  scripts
  starship
  systemd
  tmux
  zsh
)

CRITICAL_FOLDERS=(hypr)
MODE="${1:-install}"

is_critical_folder() {
  local target="$1"
  local folder
  for folder in "${CRITICAL_FOLDERS[@]}"; do
    if [[ "$folder" == "$target" ]]; then
      return 0
    fi
  done
  return 1
}

run_stow() {
  local folder="$1"
  local dry_run="${2:-false}"
  local stow_args=(--restow)

  if [[ ! -d "$folder" ]]; then
    echo "error: stow folder not found: $folder" >&2
    exit 1
  fi

  if [[ "$folder" == "herdr" ]]; then
    stow_args+=(--no-folding)
  fi

  if [[ "$dry_run" == "true" ]]; then
    stow -nv "${stow_args[@]}" "$folder"
  else
    stow "${stow_args[@]}" "$folder"
  fi
}

apply_all() {
  local dry_run="${1:-false}"
  local folder

  for folder in "${STOW_FOLDERS[@]}"; do
    if ! is_critical_folder "$folder"; then
      echo "restowing $folder"
      run_stow "$folder" "$dry_run"
    fi
  done

  for folder in "${CRITICAL_FOLDERS[@]}"; do
    echo "restowing $folder"
    run_stow "$folder" "$dry_run"
  done

  # Quattro loads user plugins from real files and rejects symlinked plugin
  # directories, so keep this tracked config synchronized by copying it.
  mkdir -p "$HOME/.config/omarchy"
  cp -a "$DOTFILES/omarchy/.config/omarchy/." "$HOME/.config/omarchy/"

  if [[ "$dry_run" != "true" ]]; then
    if command -v herdr >/dev/null 2>&1; then
      if ! herdr plugin list --json | jq -e '.result.plugins[] | select(.plugin_id == "herdr-automatic-rename" and .source.resolved_commit == "29db272b3d53a92a0773ce0798b3b3498c3ae42d")' >/dev/null; then
        herdr plugin install qu8n/herdr-automatic-rename --ref 29db272b3d53a92a0773ce0798b3b3498c3ae42d --yes
      fi
      if ! herdr plugin list --json | jq -e '.result.plugins[] | select(.plugin_id == "workspace-tab-history")' >/dev/null; then
        herdr plugin link "$HOME/.config/herdr/local-plugins/workspace-tab-history" --enabled
      fi
    else
      echo "herdr not found; skipping Herdr plugin installation"
    fi

    if command -v hyprctl >/dev/null 2>&1; then
      hyprctl reload || true
    fi
    if command -v omarchy >/dev/null 2>&1; then
      omarchy restart shell || true
    fi
  fi
}

sync_omarchy() {
  mkdir -p "$HOME/.config/omarchy"
  cp -a "$DOTFILES/omarchy/.config/omarchy/." "$HOME/.config/omarchy/"
}

preflight_conflicts() {
  local folder
  local has_conflicts="false"

  for folder in "${STOW_FOLDERS[@]}"; do
    if ! stow -n --restow "$folder" >/dev/null 2>&1; then
      has_conflicts="true"
      echo "conflict detected for $folder"
      stow -nv --restow "$folder" || true
    fi
  done

  if [[ "$has_conflicts" == "true" ]]; then
    echo "resolve conflicts, then rerun ./install" >&2
    echo "tip: one-time import for existing files: ./install adopt <folder>" >&2
    exit 1
  fi
}

adopt_folder() {
  local folder="$1"

  if [[ ! -d "$folder" ]]; then
    echo "error: stow folder not found: $folder" >&2
    exit 1
  fi

  echo "adopting $folder (one-time import mode)"
  stow --adopt "$folder"
}

if ! command -v stow >/dev/null 2>&1; then
  echo "error: stow is not installed" >&2
  exit 1
fi

pushd "$DOTFILES" >/dev/null

case "$MODE" in
  install)
    preflight_conflicts
    apply_all false
    ;;
  dry-run)
    apply_all true
    ;;
  clean)
    for folder in "${STOW_FOLDERS[@]}"; do
      echo "unlinking $folder"
      stow -D "$folder"
    done
    ;;
  sync-omarchy)
    sync_omarchy
    ;;
  adopt)
    if [[ $# -lt 2 ]]; then
      echo "usage: ./install adopt <folder> [folder ...]" >&2
      exit 1
    fi
    shift
    for folder in "$@"; do
      adopt_folder "$folder"
    done
    ;;
  *)
    echo "usage: ./install [install|dry-run|clean|sync-omarchy|adopt <folder> ...]" >&2
    exit 1
    ;;
esac

popd >/dev/null
